default_platform(:ios)

# Both bundle IDs need provisioning profiles: the app and the DeviceActivity
# monitor extension. Both carry com.apple.developer.family-controls, which
# requires Apple's approval for distribution — see docs/RELEASING.md.
APP_IDS = [
  "com.solidsoft.routine",
  "com.solidsoft.routine.ActivityMonitor"
].freeze

# Shared by the lanes below. ios.sh maps the shorter ASC_* spelling used
# everywhere else in scripts/release/ onto these names.
def asc_api_key
  app_store_connect_api_key(
    key_id:      ENV.fetch("APP_STORE_CONNECT_API_KEY_KEY_ID"),
    issuer_id:   ENV.fetch("APP_STORE_CONNECT_API_KEY_ISSUER_ID"),
    key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY_KEY"),
    is_key_content_base64: false
  )
end

platform :ios do
  # Resolve the build number from what TestFlight has already accepted for this
  # version, rather than from pubspec, which goes stale the moment you ship.
  # Apple scopes build uniqueness per version string, so a new VERSION_NAME
  # correctly restarts at 1. Written to a file because ios.sh cannot reliably
  # pick a value out of fastlane's stdout.
  desc "Write the next unused TestFlight build number to $BUILD_NUMBER_OUT"
  lane :next_build_number do
    latest = latest_testflight_build_number(
      app_identifier: APP_IDS.first,
      version: ENV.fetch("VERSION_NAME"),
      api_key: asc_api_key,
      initial_build_number: 0
    )
    File.write(ENV.fetch("BUILD_NUMBER_OUT"), (latest + 1).to_s)
  end

  desc "Push a new beta build to TestFlight (local, interactive)"
  lane :beta do
    increment_build_number(xcodeproj: "Runner.xcodeproj")
    build_app(workspace: "Runner.xcworkspace", scheme: "Runner")
    upload_to_testflight
  end

  desc "Build and upload to TestFlight from CI"
  lane :ci_beta do
    # Isolated temporary keychain so the runner's default keychain stays clean.
    # This no-ops off CI, which is what makes the p12 import below optional:
    # locally the Apple Distribution cert in your login keychain is used as-is.
    setup_ci

    api_key = asc_api_key

    # ios.sh decodes IOS_CERT_P12_B64 to a file and hands over the path. The
    # certificate is shipped in rather than minted here on purpose: Apple caps a
    # team at a handful of Apple Distribution certs, and an ephemeral runner has
    # no keychain state to reuse, so anything that creates certs on demand burns
    # through that cap one release at a time.
    if (p12 = ENV["IOS_CERT_P12_PATH"])
      import_certificate(
        certificate_path:     p12,
        certificate_password: ENV.fetch("IOS_CERT_PASSWORD"),
        # The keychain setup_ci just created, and its default empty password.
        keychain_name:     "fastlane_tmp_keychain",
        keychain_password: ""
      )
    end

    # Profiles come straight from App Store Connect on the same API key — there
    # is no shared certificate repo to bootstrap or keep in sync. sigh reuses a
    # valid profile and only mints one when it is missing or expired, so this is
    # safe to run on every release. Profiles are unlike certificates here: they
    # are free and disposable, so fetching them per run costs nothing.
    profiles = APP_IDS.to_h do |id|
      get_provisioning_profile(app_identifier: id, api_key: api_key)
      [id, lane_context[SharedValues::SIGH_NAME]]
    end

    increment_version_number(version_number: ENV.fetch("VERSION_NAME"))
    increment_build_number(build_number: ENV.fetch("BUILD_NUMBER"))

    APP_IDS.each do |id|
      update_code_signing_settings(
        path: "Runner.xcodeproj",
        use_automatic_signing: false,
        team_id: CredentialsManager::AppfileConfig.try_fetch_value(:team_id),
        bundle_identifier: id,
        profile_name: profiles.fetch(id),
        code_sign_identity: "Apple Distribution"
      )
    end

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      export_options: { provisioningProfiles: profiles }
    )

    upload_to_testflight(
      api_key: api_key,
      # Don't hold a macOS runner open for Apple's processing queue.
      skip_waiting_for_build_processing: true
    )
  end
end
